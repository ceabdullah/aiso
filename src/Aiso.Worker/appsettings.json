{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Aiso": {
    "Database": {
      "Provider": "SqlServer",
      "OracleCompatibilityVersion": 19
    },
    "Workspace": {
      "RootPath": "C:\\PROJECTS\\LOCAL LLM DEMO",
      "DataFolder": "data",
      "ReportsFolder": "reports"
    },
    "Llm": {
      "BaseUrl": "https://teb.com.tr",
      "ApiKey": "",
      "Model": "claude-3-5-sonnet-20241022",
      "MaxTokens": 1024
    },
    "ClaudeCli": {
      "Enabled": true,
      "ExecutablePath": "claude.exe",
      "PermissionMode": "default",
      "MaxTurns": 25,
      "TimeoutMinutes": 20,
      "MaxAttempts": 2,
      "DisableNonEssentialTraffic": true,
      "ExtraCaCertificatePath": "",
      "HttpsProxy": ""
    },
    "Scraper": {
      "UserAgent": "AISO-Audit-Bot/1.0 (+internal visibility audit)",
      "AcceptLanguage": "tr-TR,tr;q=0.9,en-US;q=0.8,en;q=0.7"
    },
    "Smtp": {
      "Enabled": false,
      "Host": "smtp.corp.local",
      "Port": 25,
      "EnableSsl": true,
      "FromAddress": "aiso-platform@example.com",
      "DashboardUrl": ""
    }
  }
}

@attribute [Authorize(Policy = AisoPolicies.Admin)]
@inject Aiso.Infrastructure.Settings.ISystemSettingsService Settings

<StatusMessage Message="@_message" IsError="_isError" />

<div class="settings">
    <div class="setting">
        <label for="retention">Data retention</label>
        <div class="slider-row">
            <input id="retention" type="range" min="7" max="365" step="1" @bind="_retentionDays" @bind:event="oninput" />
            <span class="slider-value">@_retentionDays days</span>
        </div>
        <p class="muted small">Audit logs and data/ snapshots older than this are purged by the maintenance sweep. Remediation plans are kept.</p>
    </div>

    <div class="setting">
        <label for="cleanup">Maintenance sweep interval</label>
        <div class="slider-row">
            <input id="cleanup" type="range" min="1" max="30" step="1" @bind="_cleanupDays" @bind:event="oninput" />
            <span class="slider-value">every @_cleanupDays day(s)</span>
        </div>
    </div>

    <div class="setting">
        <label for="threshold">Visibility alert threshold</label>
        <div class="slider-row">
            <input id="threshold" type="range" min="0" max="100" step="1" @bind="_threshold" @bind:event="oninput" />
            <span class="slider-value">@_threshold / 100</span>
        </div>
        <p class="muted small">An HTML alert email is sent when a channel's overall AISO score drops below this value.</p>
    </div>

    <div class="setting">
        <label for="interval">Audit pipeline interval</label>
        <div class="slider-row">
            <input id="interval" type="range" min="1" max="168" step="1" @bind="_auditHours" @bind:event="oninput" />
            <span class="slider-value">every @_auditHours h</span>
        </div>
    </div>

    <div class="setting">
        <label for="recipients">Alert recipients</label>
        <input id="recipients" class="input" @bind="_recipients" placeholder="audit-team@bank.local; ciso-office@bank.local" maxlength="2000" />
    </div>

    <div class="setting">
        <label for="theme">Default theme for new users</label>
        <select id="theme" class="input input-sm" @bind="_theme">
            <option value="dark">Dark</option>
            <option value="light">Light</option>
        </select>
    </div>
</div>

<div class="toolbar">
    <button class="btn btn-primary" disabled="@_saving" @onclick="SaveAsync">Save settings</button>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private int _retentionDays = 30, _cleanupDays = 7, _threshold = 60, _auditHours = 24;
    private string _recipients = string.Empty, _theme = "dark";
    private bool _saving;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        _retentionDays = await Settings.GetIntAsync(SettingKeys.DataRetentionDays);
        _cleanupDays = await Settings.GetIntAsync(SettingKeys.CleanupIntervalDays);
        _threshold = await Settings.GetIntAsync(SettingKeys.VisibilityAlertThreshold);
        _auditHours = await Settings.GetIntAsync(SettingKeys.AuditIntervalHours);
        _recipients = await Settings.GetStringAsync(SettingKeys.AlertRecipients);
        _theme = await Settings.GetStringAsync(SettingKeys.DefaultUiTheme);
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var user = (await AuthState).User.Identity?.Name;
            var inv = CultureInfo.InvariantCulture;
            await Settings.SetAsync(SettingKeys.DataRetentionDays, _retentionDays.ToString(inv), user);
            await Settings.SetAsync(SettingKeys.CleanupIntervalDays, _cleanupDays.ToString(inv), user);
            await Settings.SetAsync(SettingKeys.VisibilityAlertThreshold, _threshold.ToString(inv), user);
            await Settings.SetAsync(SettingKeys.AuditIntervalHours, _auditHours.ToString(inv), user);
            await Settings.SetAsync(SettingKeys.AlertRecipients, _recipients.Trim(), user);
            await Settings.SetAsync(SettingKeys.DefaultUiTheme, _theme == "light" ? "light" : "dark", user);
            (_message, _isError) = ("Settings saved. The worker applies them on its next cycle.", false);
        }
        catch (Exception ex)
        {
            (_message, _isError) = ($"Save failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }
}

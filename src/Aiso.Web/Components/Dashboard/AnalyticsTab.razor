@inject DashboardService Dashboard

<div class="toolbar">
    <label class="muted small" for="range">Window</label>
    <select id="range" class="input input-sm" @bind="Days" @bind:after="LoadAsync">
        <option value="7">7 days</option>
        <option value="30">30 days</option>
        <option value="90">90 days</option>
        <option value="365">365 days</option>
    </select>
</div>

@if (_data is null)
{
    <p class="muted">Loading…</p>
    return;
}

<div class="panel">
    <h3>Overall score trend</h3>
    @if (_data.Trends.Count == 0)
    {
        <p class="muted">No audits in this window.</p>
    }
    else
    {
        <TrendChart Trends="_data.Trends" />
    }
</div>

<div class="grid-2">
    <div class="panel">
        <h3>LLM visibility by language</h3>
        <table class="table">
            <thead><tr><th>Channel</th><th>Lang</th><th class="num">Mentioned</th><th>Rate</th></tr></thead>
            <tbody>
                @foreach (var l in _data.Languages)
                {
                    <tr>
                        <td>@l.Target</td>
                        <td class="mono">@l.LanguageCode</td>
                        <td class="num">@l.Mentioned / @l.Evaluated</td>
                        <td><Bar Value="l.Rate" /></td>
                    </tr>
                }
                @if (_data.Languages.Count == 0)
                {
                    <tr><td colspan="4" class="muted">No prompt probes recorded yet.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="panel">
        <h3>Recent audits</h3>
        <table class="table">
            <thead><tr><th>When (UTC)</th><th>Channel</th><th>Status</th><th class="num">Score</th><th class="num">ms</th></tr></thead>
            <tbody>
                @foreach (var a in _data.RecentAudits)
                {
                    <tr title="@a.Error">
                        <td class="mono small">@a.AtUtc.ToString("MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                        <td>@a.Target</td>
                        <td><span class="chip @StatusCss(a.Status)">@a.Status</span></td>
                        <td class="num">@a.Overall.ToString("0.0", CultureInfo.InvariantCulture)</td>
                        <td class="num muted">@a.DurationMs</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="panel">
    <h3>On-page signal matrix <span class="muted small">(latest audit per channel)</span></h3>
    <div class="table-scroll">
        <table class="table matrix">
            <thead>
                <tr>
                    <th>Channel</th>
                    @foreach (var name in _data.Signals.SignalNames)
                    {
                        <th class="rot"><span>@name</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _data.Signals.Rows)
                {
                    <tr>
                        <td>@row.Target</td>
                        @foreach (var name in _data.Signals.SignalNames)
                        {
                            if (row.Signals.TryGetValue(name, out var s))
                            {
                                <td class="cell @(s.Passed ? "pass" : "fail")" title="@s.Detail (weight @s.Weight)">@(s.Passed ? "✓" : "✗")</td>
                            }
                            else
                            {
                                <td class="cell na">·</td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private AnalyticsData? _data;
    private int Days { get; set; } = 30;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _data = await Dashboard.GetAnalyticsAsync(Days);

    private static string StatusCss(AuditStatus s) => s switch
    {
        AuditStatus.Succeeded => "chip-ok",
        AuditStatus.PartiallySucceeded => "chip-warn",
        AuditStatus.Failed => "chip-bad",
        _ => string.Empty,
    };
}

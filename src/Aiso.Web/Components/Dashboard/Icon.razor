@* Inline line icons (no icon font or CDN on the corporate network). Decorative unless Label is set. *@
<svg class="icon @Class" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="@(Label is null ? "true" : null)" role="@(Label is null ? null : "img")" aria-label="@Label">
    <path d="@PathFor(Name)" />
</svg>

